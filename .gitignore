# App data & generated output
# Example Data/ (the CSV exports) and data/ (the live Unleashed sync cache) are
# both COMMITTED so the deployed backend has data. ⚠ They contain real
# customer/sales data — keep this repo PRIVATE. Refresh the cache with
# `uv run sync`, then commit & push so deployed copies pick it up.

# Generated sales reports (re-run: python3 build_reports.py)
reports/

# Per-customer learned preferences (runtime state from the rep feedback loop)
feedback/
# Per-customer live intel (summarised WhatsApp updates)
notes/
# Businesses reps created in Unleashed from a visit (runtime state)
prospects/

